    {
      "parameters": {
        "content": "# Fase 1 \n\nColeta dos dados via Google Forms e hierarquizados para produção de e-mails via Google Gemini.\n",
        "height": 384,
        "width": 1536
      },
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        -2000,
        -560
      ],
      "typeVersion": 1,
      "id": "609fad54-29fb-44e2-9d1d-278c25d9ef66",
      "name": "Sticky Note"
    },
    {
      "parameters": {
        "jsCode": "// Executado uma vez para item\n//Recuperação dos dados correspondentes à resposta do Gemini\n\n// variavel dados de origem\nconst origem = $('Edit Fields1').item.json;\nconst dados = $json;\n\nlet texto = dados.content?.parts?.map(p => p.text ?? '').join('')\n  ?? dados.candidates?.[0]?.content?.part?.map(p => p.text ?? '').join('')\n  ?? dados.text ?? dados.output ?? '';\n\nif (typeof texto !== 'string') texto = JSON.stringify(texto);\ntexto = texto.trim().replace(/^```(?:json)?\\s*/i, '').replace(/\\s*```$/, '');\n\n//válida se o texto foi convertido para o formato JSON\nlet resposta;\ntry{ resposta = JSON.parse(texto); }\ncatch (e) { throw new Error('Gemini não retornou JSON válido: ' +texto.slice(0,350)); }\n\n//checagem do tipo para resposta e mensagem\nif (typeof resposta.assunto !== 'string' || !resposta.assunto.trim() ||\n    typeof resposta.mensagem !== 'string' || !resposta.mensagem.trim()) {\n   throw new Error('Gemini não retornou assunto e mensagem válidos.');\n    }\n\nreturn{ json:{\n  ra:origem.ra,\n  nomecompleto:origem.nomecompleto,\n  email:origem.email,\n  interesse:origem.interesse,\n  assunto:resposta.assunto.trim(),\n  mensagem:resposta.mensagem.trim(),\n  status:'Em revisão'\n}};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
